# Copy to .env (same folder as pyproject.toml).

# Required: your Personal API key from https://connect.garmin.com/app/settings/personalApiToken
GARMIN_PERSONAL_API_KEY=

# Optional
# GARMIN_DOWNLOAD_DIR=~/Downloads/garmin
# GARMIN_TIMEOUT_SECONDS=30
# GARMIN_LOG_LEVEL=WARNING

# Transport: stdio (Claude Desktop / Claude Code) or streamable-http (ChatGPT, remote clients)
# GARMIN_MCP_TRANSPORT=stdio
# GARMIN_MCP_HOST=127.0.0.1
# GARMIN_MCP_PORT=8000
# Use a long random path when the server is reachable from the internet, e.g. /mcp-<random>
# GARMIN_MCP_PATH=/mcp
